{
  "name": "site-graca-e-vida",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/admin.ts src/mural-live.ts --bundle --format=esm --minify --target=es2020 --outdir=js",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "dev:api": "neon dev",
    "deploy": "neon deploy --env .env.local",
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "test:admin": "node --env-file=.env.local scripts/teste-admin.mjs",
    "test:equipe": "node --env-file=.env.local scripts/teste-equipe.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-presigned-post": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "files-sdk": "^3.2.0",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}